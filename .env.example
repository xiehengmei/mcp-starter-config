# 只填你打算启用的；留空的服务器 configure.sh 会跳过
# Context7: https://context7.com/dashboard 免费取 key，用于提高限速
CONTEXT7_API_KEY=

# Brave: https://api-dashboard.search.brave.com/app/keys
BRAVE_API_KEY=

# Firecrawl: https://www.firecrawl.dev/app/api-keys
# 不想注册可以改用免 key 托管端点 https://mcp.firecrawl.dev/v2/mcp
FIRECRAWL_API_KEY=

# GitHub: https://github.com/settings/personal-access-tokens/new
# 最小 scope: repo, read:packages, read:org。不要给 admin:org
GITHUB_PERSONAL_ACCESS_TOKEN=
